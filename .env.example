# Auth.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
# Production (behind nginx): set both to the public HTTPS origin
# AUTH_URL=https://n.example.com
# AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=change-me

# Optional bootstrap only — preferred: Admin → Sign-in (DB overrides env when configured)
# Custom OIDC (e.g. a.rclmx.info)
# OIDC_ISSUER=https://a.rclmx.info
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_ID=oidc
# OIDC_PROVIDER_NAME=Company login
# Google is also OIDC (issuer https://accounts.google.com)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Yandex is optional OAuth (not OIDC)
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=

# Comma-separated allowlist; seeded as admins
ALLOWED_EMAILS=admin@example.com

# Internal API key (worker + MCP → portal)
INTERNAL_API_KEY=change-me

# Cursor CLI (env-only in v1)
CURSOR_API_KEY=

# Optional: absolute path to Cursor CLI binary (default: agent on PATH)
# CURSOR_CLI_PATH=/usr/local/bin/agent

# Cursor agent working directory (VPS slim install uses /opt/newsdigest/workspace)
# AGENT_WORKSPACE=/opt/newsdigest/workspace

# Telegra.ph (may also be stored in DB via admin)
TELEGRAPH_ACCESS_TOKEN=

# Telegram MTProto — optional env fallback. Prefer Admin → API keys (encrypted in DB).
# Create at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional dedicated secret for encrypting linked sessions (falls back to NEXTAUTH_SECRET)
# CONNECTIONS_SECRET=

# SQLite (Prisma) — path relative to apps/web/prisma/schema.prisma
DATABASE_URL=file:./dev.db

# Optional: illustration files for the home board (default: illustrations/ next to DATABASE_URL)
# ILLUSTRATIONS_DIR=/app/data/illustrations
