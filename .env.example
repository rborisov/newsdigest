# Auth.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yandex OAuth
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Comma-separated allowlist; seeded as admins
ALLOWED_EMAILS=admin@example.com

# Internal API key (worker + MCP → portal)
INTERNAL_API_KEY=change-me

# Cursor CLI (env-only in v1)
CURSOR_API_KEY=

# Optional: absolute path to Cursor CLI binary (default: agent on PATH)
# CURSOR_CLI_PATH=/usr/local/bin/agent

# Cursor agent working directory (VPS slim install uses /opt/newsdigest/workspace)
# AGENT_WORKSPACE=/opt/newsdigest/workspace

# Telegra.ph (may also be stored in DB via admin)
TELEGRAPH_ACCESS_TOKEN=

# SQLite (Prisma) — path relative to apps/web/prisma/schema.prisma
DATABASE_URL=file:./dev.db

# Optional: illustration files for the home board (default: illustrations/ next to DATABASE_URL)
# ILLUSTRATIONS_DIR=/app/data/illustrations
