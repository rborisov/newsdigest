generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum GenerationJobStatus {
  pending
  running
  completed
  failed
}

enum TriggerType {
  manual
  scheduled
  agent
}

enum GenerationStepKind {
  topic_draft
  merge_publish
  topic_publish
}

enum GenerationStepStatus {
  pending
  running
  completed
  failed
}

model Topic {
  id         String    @id @default(cuid())
  name       String
  /// Mirrored from enabled web TopicSource keywords until digests read sources directly.
  keywords   String    @default("")
  enabled    Boolean   @default(true)
  sortOrder  Int       @default(0)
  /// null = use the default schedule
  scheduleId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  schedule   Schedule?     @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  topicPages TopicPage[]
  sources    TopicSource[]
  ingestItems IngestItem[]
  faqSpace   FaqSpace?
}

/// Living FAQ product linked 1:1 to a topic (DD-0005 Phase 5).
model FaqSpace {
  id             String   @id @default(cuid())
  topicId        String   @unique
  enabled        Boolean  @default(false)
  /// URL segment for /faq/[slug]
  slug           String   @unique
  name           String   @default("")
  promptTemplate String   @default("")
  keywords       String   @default("")
  /// inherit_topic | subset | custom (v1: inherit_topic)
  sourceMode     String   @default("inherit_topic")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  topic   Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  entries FaqEntry[]

  @@index([enabled])
}

model FaqEntry {
  id              String    @id @default(cuid())
  faqSpaceId      String
  question        String
  /// Normalized hint for clustering (not unique — flat list allows duplicates)
  questionKey     String
  /// Stable fingerprint of evidence ids; dedupes re-sync appends
  evidenceKey     String
  answer          String    @default("")
  /// active | expired | conflict | archived
  status          String    @default("active")
  lastConfirmedAt DateTime?
  expiresAt       DateTime?
  confidence      Float?
  evidenceJson    String    @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  faqSpace FaqSpace @relation(fields: [faqSpaceId], references: [id], onDelete: Cascade)

  @@unique([faqSpaceId, evidenceKey])
  @@index([faqSpaceId, status])
}

/// One ingest/config source attached to a topic (DD-0005 Phase 2).
model TopicSource {
  id           String    @id @default(cuid())
  topicId      String
  /// web | telegram | rss | vk | x | …
  kind         String
  enabled      Boolean   @default(true)
  sortOrder    Int       @default(0)
  /// kind-specific JSON, e.g. web {keywords}, telegram {peers, lookbackHours}
  configJson   String    @default("{}")
  /// Optional FK when kind needs a linked SocialConnection (v1 telegram may resolve globally).
  connectionId String?
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  topic      Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  connection SocialConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  ingestItems IngestItem[]

  @@index([topicId, sortOrder])
  @@index([kind, enabled])
}

/// Normalized item from a source adapter after rule filtering (DD-0005 Phase 3).
model IngestItem {
  id            String    @id @default(cuid())
  topicId       String
  topicSourceId String?
  /// telegram | web | rss | …
  kind          String
  /// Stable id within kind, e.g. telegram peer:messageId
  externalId    String
  url           String?
  title         String?
  text          String
  publishedAt   DateTime?
  /// kept | ads | fluff | question | other
  quality       String    @default("kept")
  rawJson       String    @default("{}")
  createdAt     DateTime  @default(now())

  topic       Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicSource TopicSource? @relation(fields: [topicSourceId], references: [id], onDelete: SetNull)

  @@unique([topicId, kind, externalId])
  @@index([topicId, quality, publishedAt])
  @@index([topicSourceId])
}

model Schedule {
  id            String   @id @default(cuid())
  name          String
  /// Derived for the worker; do not edit by hand in Admin.
  cronExpr      String
  timezone      String   @default("UTC")
  enabled       Boolean  @default(true)
  /// Topics with scheduleId=null run on this schedule.
  isDefault     Boolean  @default(false)
  /// daily | weekly | interval_hours
  recurrence    String   @default("daily")
  /// HH:MM local to timezone
  timeOfDay     String   @default("09:00")
  /// 0=Sunday … 6=Saturday when recurrence=weekly
  weekday       Int?
  /// When recurrence=interval_hours
  intervalHours Int?
  /// Lookback for {{PERIOD_HOURS}}; null = use PromptConfig.periodHours
  periodHours   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  topics Topic[]
  jobs   GenerationJob[]
}

model PromptConfig {
  id              String @id @default("default")
  template        String
  periodHours     Int    @default(24)
  boardStaleDays  Int    @default(0)
  /// IANA timezone for portal/index clocks and agent title times (e.g. Europe/Moscow).
  displayTimezone String @default("UTC")
  /// Free-text language for {{LANGUAGE}} in the prompt (e.g. Russian, English).
  language        String @default("English")
  /// Default template for per-story AI reviews (Telegra.ph).
  reviewTemplate  String @default("")
  updatedAt       DateTime @updatedAt
}

model TelegraphMeta {
  id                    String    @id @default("default")
  accessToken           String    @default("")
  currentIndexPath      String    @default("")
  currentIndexUrl       String    @default("")
  currentReviewIndexPath String   @default("")
  currentReviewIndexUrl  String   @default("")
  authorName            String    @default("")
  authorUrl             String    @default("")
  /// Exclusive lock expiry for serializing index updates (null = unlocked).
  indexLockUntil        DateTime?
  updatedAt             DateTime  @updatedAt
}

model TelegraphIndexPage {
  id             String    @id @default(cuid())
  telegraphPath  String
  telegraphUrl   String
  previousIndexId String?
  isCurrent      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  closedAt       DateTime?

  previousIndex TelegraphIndexPage?  @relation("IndexChain", fields: [previousIndexId], references: [id])
  nextIndexes   TelegraphIndexPage[] @relation("IndexChain")
  publishedPages PublishedPage[]
  topicPages    TopicPage[]
}

/// Telegra.ph index listing published story reviews (newest first).
model TelegraphReviewIndexPage {
  id              String    @id @default(cuid())
  telegraphPath   String
  telegraphUrl    String
  previousIndexId String?
  isCurrent       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  closedAt        DateTime?

  previousIndex TelegraphReviewIndexPage?  @relation("ReviewIndexChain", fields: [previousIndexId], references: [id])
  nextIndexes   TelegraphReviewIndexPage[] @relation("ReviewIndexChain")
  reviews       StoryReview[]
}

model GenerationJob {
  id          String              @id @default(cuid())
  status      GenerationJobStatus @default(pending)
  triggerType TriggerType
  error       String?
  scheduleId  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  schedule      Schedule?         @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  publishedPage PublishedPage?
  topicPages    TopicPage[]
  steps         GenerationStep[]
}

model GenerationStep {
  id               String               @id @default(cuid())
  jobId            String
  kind             GenerationStepKind
  status           GenerationStepStatus @default(pending)
  sortOrder        Int
  topicId          String?
  topicName        String?
  draftHtml        String?
  draftStoriesJson String?
  error            String?
  /// Token usage from Cursor CLI stream-json (null until recorded)
  inputTokens      Int?
  outputTokens     Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  totalTokens      Int?
  model            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sortOrder])
  @@index([jobId, status])
}

/// Legacy merged digest pages (pre–topic-board). New publishes use TopicPage.
model PublishedPage {
  id            String      @id @default(cuid())
  title         String
  telegraphPath String
  telegraphUrl  String
  indexPageId   String?
  triggerType   TriggerType
  triggeredBy   String
  jobId         String      @unique
  createdAt     DateTime    @default(now())

  indexPage TelegraphIndexPage? @relation(fields: [indexPageId], references: [id], onDelete: SetNull)
  job       GenerationJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stories   PublishedStory[]
}

/// Legacy story fingerprints linked to PublishedPage. New publishes use StoryIndex.
model PublishedStory {
  id              String   @id @default(cuid())
  canonicalUrl    String?  @unique
  title           String
  titleKey        String?
  firstSeenAt     DateTime @default(now())
  publishedPageId String

  publishedPage PublishedPage @relation(fields: [publishedPageId], references: [id], onDelete: Cascade)

  @@index([titleKey])
  @@index([firstSeenAt])
}

model TopicPage {
  id            String      @id @default(cuid())
  topicId       String?
  topicName     String
  title         String
  /// Digest body HTML for the home board (same content published to Telegra.ph).
  htmlContent   String      @default("")
  telegraphPath String
  telegraphUrl  String
  indexPageId   String?
  triggerType   TriggerType
  triggeredBy   String
  jobId         String?
  stepId        String?     @unique
  publishedAt   DateTime    @default(now())

  topic     Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  indexPage TelegraphIndexPage? @relation(fields: [indexPageId], references: [id], onDelete: SetNull)
  job       GenerationJob?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  stories   StoryIndex[]

  @@index([topicId, publishedAt])
  @@index([publishedAt])
}

model StoryIndex {
  id           String   @id @default(cuid())
  topicPageId  String
  canonicalUrl String?  @unique
  title        String
  titleKey     String?
  firstSeenAt  DateTime @default(now())

  topicPage TopicPage    @relation(fields: [topicPageId], references: [id], onDelete: Cascade)
  review    StoryReview?

  @@index([titleKey])
  @@index([firstSeenAt])
}

/// AI review of a single story, published to Telegra.ph.
model StoryReview {
  id            String    @id @default(cuid())
  storyIndexId  String    @unique
  status        String    @default("pending")
  promptUsed    String    @default("")
  title         String    @default("")
  telegraphPath String    @default("")
  telegraphUrl  String    @default("")
  createdBy     String    @default("")
  error         String?
  pid           Int?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reviewIndexPageId String?

  story           StoryIndex              @relation(fields: [storyIndexId], references: [id], onDelete: Cascade)
  reviewIndexPage TelegraphReviewIndexPage? @relation(fields: [reviewIndexPageId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishedAt])
  @@index([reviewIndexPageId])
}

/// Linked social / messaging accounts for multi-source ingest (DD-0005).
/// v1: at most one row per provider (e.g. one Telegram user session).
model SocialConnection {
  id           String    @id @default(cuid())
  /// telegram | vk | x | …
  provider     String
  /// linked | linking | error | disconnected
  status       String    @default("disconnected")
  displayName  String    @default("")
  externalId   String    @default("")
  /// AES-GCM encrypted MTProto / OAuth session material
  sessionEnc   String    @default("")
  /// AES-GCM encrypted mid-login state (phone, phoneCodeHash, …)
  linkStateEnc String    @default("")
  /// AES-GCM encrypted my.telegram.org app credentials { apiId, apiHash }
  appConfigEnc String    @default("")
  lastError    String?
  linkedAt     DateTime?
  linkedBy     String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([provider])
  @@index([status])

  topicSources TopicSource[]
}

model AllowedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Auth.js Prisma adapter models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AboutPage {
  id                 String   @id @default("default")
  enabledEn          Boolean  @default(true)
  enabledRu          Boolean  @default(true)
  footerLabelEn      String   @default("About / Collaboration")
  footerLabelRu      String   @default("О продукте / Сотрудничество")
  pageTitleEn        String   @default("")
  pageTitleRu        String   @default("")
  leadEn             String   @default("")
  leadRu             String   @default("")
  productEn          String   @default("")
  productRu          String   @default("")
  outlookEn          String   @default("")
  outlookRu          String   @default("")
  collaborationEn    String   @default("")
  collaborationRu    String   @default("")
  updatedAt          DateTime @updatedAt
}
